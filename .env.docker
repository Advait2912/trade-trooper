# =====================================================
# Alpaca Market Data & Paper Trading API
# Sign up at https://alpaca.markets/ to get your free Paper Trading keys
# =====================================================
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here
ALPACA_DATA_FEED=iex
ALPACA_OPTIONS_FEED=indicative

# =====================================================
# Paper Trading Execution (ENABLED IN DOCKER)
# =====================================================
TRADING_ENABLED=true
TRADING_INTERVAL_MIN=5
MAX_OPEN_POSITIONS=5
DAILY_LOSS_LIMIT_PCT=0.05
ACCOUNT_CAPITAL=100000
RISK_PER_TRADE_PCT=0.01
MIN_RISK_REWARD=1.0
MIN_CONFIDENCE=0.35
TRADE_HORIZON_DAYS=3

# =====================================================
# Shared FinBERT & LLM Connections
# =====================================================
FINBERT_URL=http://finbert:8000
ENABLE_WEB_RESEARCH=false
ENABLE_LLM_SYNTHESIS=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral

# =====================================================
# Asset Class Controls (Default: Options Only)
# =====================================================
OPTIONS_ONLY=true
EQUITY_ONLY=false
